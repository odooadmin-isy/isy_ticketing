<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ISY Transportation Destination Tree -->
        <record model="ir.ui.view" id="isy_destination_tree">
            <field name="name">ISY Transportation Destination Tree</field>
            <field name="model">isy.destination</field>
            <field name="arch" type="xml">
                <tree default_order='name desc'>
                    <field name="name"/>
                    <field name="is_other_destination"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- ISY Transportation Destination Form -->
        <record model="ir.ui.view" id="isy_destination_form">
            <field name="name">ISY Transportation Destination Form</field>
            <field name="model">isy.destination</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group cols="2">
                            <group>
                                <field name="name"/>
                                <field name="is_other_destination"/>
                                <field name="active"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- ISY Transportation Destination Action -->
        <record model="ir.actions.act_window" id="menu_isy_destination_action">
            <field name="name">ISY Transportation Destination</field>
            <field name="res_model">isy.destination</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ISY Transportation Destination Menu -->
        <menuitem
            name="ISY Transportation Destination"
            id="isy_ticketing.menu_isy_destination"
            parent="isy_ticketing.menu_settings"
            action="isy_ticketing.menu_isy_destination_action"
            sequence="14"/>

        <!-- Transportation Logbook Tree View -->
        <record model="ir.ui.view" id="transportation_logbook_tree">
            <field name="name">Transportation Logbook Tree</field>
            <field name="model">transportation.logbook</field>
            <field name="arch" type="xml">
                <tree default_order='name desc'>
                    <field name="name"/>
                    <field name="destination_id" string="Destination"/>
                    <field name="vehicle_id" string="Vehicle"/>
                    <field name="date"/>
                    <field name="create_uid" string="Created By"/>
                    <field name="start_mileage"/>
                    <field name="end_mileage"/>
                </tree>
            </field>
        </record>

        <!-- Transportation Logbook Form View -->
        <record model="ir.ui.view" id="transportation_logbook_form">
            <field name="name">Transportation Logbook Form</field>
            <field name="model">transportation.logbook</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group cols="2">
                            <group>
                                <field name="date"/>
                                <field name="destination_id" string="Destination"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="is_other_destination" invisible="1"/>
                                <field name="other_destination" readonly="is_other_destination == False"
                                    required="is_other_destination == True"/>
                                <field name="create_uid" string="Created By" readonly="1"/>
                                <field name="create_date" string="Created On" readonly="1"/>
                            </group>
                            <group>
                                <field name="vehicle_id" string="Vehicle"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="driver_id" string="Driver"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="start_mileage"/>
                                <field name="end_mileage"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Transportation Logbook Action -->
        <record model="ir.actions.act_window" id="menu_transportation_logbook_action">
            <field name="name">Transportation Logbook</field>
            <field name="res_model">transportation.logbook</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Transportation Logbook Menu -->
        <menuitem
            name="Transportation Logbook"
            id="isy_ticketing.menu_transportation_logbook"
            parent="isy_ticketing.menu_logbooks"
            action="isy_ticketing.menu_transportation_logbook_action"
            sequence="1"/>

    </data>
</odoo>
