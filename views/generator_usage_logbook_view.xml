<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ISY Generator Tree -->
        <record model="ir.ui.view" id="isy_generator_tree">
            <field name="name">ISY Generator Tree</field>
            <field name="model">isy.generator</field>
            <field name="arch" type="xml">
                <tree default_order='name desc'>
                    <field name="name"/>
                    <field name="generator_location"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- ISY Generator Form -->
        <record model="ir.ui.view" id="isy_generator_form">
            <field name="name">ISY Generator Form</field>
            <field name="model">isy.generator</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group cols="2">
                            <group>
                                <field name="name"/>
                                <field name="generator_location" string="Location"/>
                                <field name="active"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ISY Generator Search -->
        <record model="ir.ui.view" id="isy_generator_search">
            <field name="name">ISY Generator Search</field>
            <field name="model">isy.generator</field>
            <field name="arch" type="xml">
                <search string="Generators">
                    <field name="name"/>
                    <field name="generator_location" string="Location"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Location" name="group_location" context="{'group_by': 'generator_location'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ISY Generator Action -->
        <record model="ir.actions.act_window" id="menu_isy_generator_action">
            <field name="name">ISY Generator</field>
            <field name="res_model">isy.generator</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ISY Generator Menu -->
        <menuitem
            name="ISY Generator"
            id="isy_ticketing.menu_isy_generator"
            parent="isy_ticketing.menu_settings"
            action="isy_ticketing.menu_isy_generator_action"
            sequence="13"/>

        <!-- Generator Usage Logbook Tree View -->
        <record model="ir.ui.view" id="generator_usage_logbook_tree">
            <field name="name">Generator Usage Logbook Tree</field>
            <field name="model">generator.usage.logbook</field>
            <field name="arch" type="xml">
                <tree default_order='name desc'>
                    <field name="name"/>
                    <field name="generator_location"/>
                    <field name="generator_id" string="Generator"/>
                    <field name="date"/>
                    <field name="create_uid" string="Created By"/>
                    <field name="total_usage"/>
                    <field name="price_per_liter"/>
                    <field name="total_cost"/>
                </tree>
            </field>
        </record>

        <!-- Generator Usage Logbook Form View -->
        <record model="ir.ui.view" id="generator_usage_logbook_form">
            <field name="name">Generator Usage Logbook Form</field>
            <field name="model">generator.usage.logbook</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group cols="2">
                            <group>
                                <field name="generator_location" string="Location"/>
                                <field name="generator_id" string="Generator"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="total_usage"/>
                                <field name="price_per_liter" string="Price Per Liter (MMK)"/>
                                <field name="total_cost" string="Total Cost"/>
                                <field name="create_uid" string="Created By" readonly="1"/>
                                <field name="create_date" string="Created On" readonly="1"/>
                            </group>
                            <group>
                                <field name="date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Generator Usage Logbook Search -->
        <record model="ir.ui.view" id="generator_usage_logbook_search">
            <field name="name">Generator Usage Logbook Search</field>
            <field name="model">generator.usage.logbook</field>
            <field name="arch" type="xml">
                <search string="Generator Usage Logbook">
                    <field name="name"/>
                    <field name="generator_id" string="Generator"/>
                    <field name="generator_location" string="Location"/>
                    <field name="date"/>
                    <field name="create_uid" string="Created By"/>
                    <field name="note"/>
                    <separator/>
                    <filter string="ISY" name="filter_isy" domain="[('generator_location', '=', 'isy')]"/>
                    <filter string="Housing/Residence" name="filter_residence" domain="[('generator_location', '=', 'residence')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Location" name="group_location" context="{'group_by': 'generator_location'}"/>
                        <filter string="Generator" name="group_generator" context="{'group_by': 'generator_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                        <filter string="Created By" name="group_create_uid" context="{'group_by': 'create_uid'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Generator Usage Logbook Action -->
        <record model="ir.actions.act_window" id="menu_generator_usage_logbook_action">
            <field name="name">Generator Usage Logbook</field>
            <field name="res_model">generator.usage.logbook</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Generator Usage Logbook Menu -->
        <menuitem
            name="Generator Usage Logbook"
            id="isy_ticketing.menu_generator_usage_logbook"
            parent="isy_ticketing.menu_logbooks"
            action="isy_ticketing.menu_generator_usage_logbook_action"
            sequence="3"/>

    </data>
</odoo>
