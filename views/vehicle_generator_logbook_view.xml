<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="vehicle_generator_logbook_tree">
            <field name="name">Vehicle Generator Logbook Tree</field>
            <field name="model">vehicle.generator.logbook</field>
            <field name="arch" type="xml">
                <tree default_order='name desc'>
                    <field name="name"/>
                    <field name="logbook_type"/>
                    <field name="date"/>
                    <field name="create_uid" string="Created By"/>
                    <field name="amount_purchased"/>
                    <field name="price_per_liter"/>
                    <field name="total_price"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vehicle_generator_logbook_form">
            <field name="name">Vehicle Generator Logbook Form</field>
            <field name="model">vehicle.generator.logbook</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group cols="2">
                            <group>
                                <field name="logbook_type" string="Type"/>
                                <field name="amount_purchased"/>
                                <field name="price_per_liter"/>
                                <field name="total_price"/>
                                <field name="create_uid" string="Created By" readonly="1"/>
                                <field name="create_date" string="Created On" readonly="1"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="fuel_type" invisible="logbook_type == 'generator'"/>
                                <field name="vehicle_id" invisible="logbook_type == 'generator'"
                                    options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="driver_id" invisible="logbook_type == 'generator'"
                                    options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="current_mileage" invisible="logbook_type == 'generator'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="menu_vehicle_generator_logbook_action">
            <field name="name">Vehicle/Generator Logbook</field>
            <field name="res_model">vehicle.generator.logbook</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            name="Vehicle/Generator Logbook"
            id="isy_ticketing.menu_vehicle_generator_logbook"
            parent="isy_ticketing.menu_logbooks"
            action="isy_ticketing.menu_vehicle_generator_logbook_action"
            sequence="2"/>

    </data>
</odoo>
